-- ปุ่ม Toggle (ปุ่มเปิด-ปิดหน้าต่าง แบบลากเลื่อนได้ + เอฟเฟกต์สีรุ้งวิ่งตามแบบในภาพ)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 45, 0, 45)
toggleBtn.Position = UDim2.new(0, 50, 0, 50)
toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
toggleBtn.Text = "UI"
toggleBtn.TextSize = 14
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.Active = true
toggleBtn.Draggable = true
toggleBtn.Parent = screenGui

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggleBtn

-- ระบบเปลี่ยนสีรุ้งให้อัตโนมัติ (วิ่งวนลูปสี RGB)
task.spawn(function()
    while screenGui and screenGui.Parent do
        for i = 0, 1, 0.005 do
            if not screenGui or not screenGui.Parent then break end
            local rainbowColor = Color3.fromHSV(i, 1, 1)
            toggleBtn.BackgroundColor3 = rainbowColor
            task.wait(0.03)
        end
    end
end)

-- สถานะเปิดปิดหน้าต่าง
local isOpen = true

-- คลิกซ้าย = เปิด/ปิดหน้าต่างหลัก
toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    frame.Visible = isOpen
end)

-- คลิกขวา = ลบ UI ทิ้งทันที (ตามแบบในภาพตัวอย่างที่คุณส่งมา)
toggleBtn.MouseButton2Click:Connect(function()
    screenGui:Destroy()
end)

-- ระบบสั่งการเมื่อกดปุ่มเล่นเพลง
button.MouseButton1Click:Connect(function()
    local songId = textBox.Text
    if songId ~= "" then
        local args = {
            "ToolMusicText",
            songId,
            [4] = true
        }
        game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
        statusLabel.Text = "✅ ส่งเพลงสำเร็จ!"
        task.wait(1)
        statusLabel.Text = "🌈 Rainbow Mode Active"
    else
        textBox.PlaceholderText = "โปรดใส่ ID เพลงก่อน!"
    end
end)

print("🌈 Music Rainbow UI (Black & White Theme) Loaded!")
