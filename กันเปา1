-- สร้าง UI หน้าต่างเปลี่ยนเพลง Tool (ช่องใส่เพลงล็อคคำอัจฉริยะ + วิบวับขาวดำแบบช้าๆ)
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if playerGui:FindFirstChild("ToolMusicUI_SlowBWFlasher") then
    playerGui.ToolMusicUI_SlowBWFlasher:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ToolMusicUI_SlowBWFlasher"
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 150)
frame.Position = UDim2.new(0.5, -130, 0.4, -75)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

-- ขอบเรืองแสงวิบวับ ขาว-ดำ
local stroke = Instance.new("UIStroke")
stroke.Thickness = 3
stroke.Parent = frame

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.BackgroundTransparency = 1
title.Text = "🎵 กันเจาะเปาสุดหล่อ"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 14
title.Font = Enum.Font.GothamBold
title.Parent = frame

-- ช่องใส่ ID เพลง (ระบบ Smart Placeholder / ล็อคคำ)
local textBox = Instance.new("TextBox")
textBox.Size = UDim2.new(0, 220, 0, 35)
textBox.Position = UDim2.new(0.5, -110, 0, 45)
textBox.Text = "ช่องใส่เพลง"
textBox.TextColor3 = Color3.fromRGB(150, 150, 150) -- สีเทาตอนแสดงคำว่าช่องใส่เพลง
textBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
textBox.TextSize = 14
textBox.Font = Enum.Font.Gotham
textBox.Parent = frame

local boxCorner = Instance.new("UICorner")
boxCorner.CornerRadius = UDim.new(0, 6)
boxCorner.Parent = textBox

local isUserTyping = false

-- จัดการข้อความอัจฉริยะ (เมื่อกดพิมพ์จะหายไป, เมื่อลบหมดจะกลับมา)
textBox.Focused:Connect(function()
    if textBox.Text == "ช่องใส่เพลง" then
        textBox.Text = ""
        textBox.TextColor3 = Color3.fromRGB(255, 255, 255) -- เปลี่ยนเป็นสีขาวตอนพิมพ์จริง
    end
end)

textBox.FocusLost:Connect(function()
    if textBox.Text == "" then
        textBox.Text = "ช่องใส่เพลง"
        textBox.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end)

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 220, 0, 35)
button.Position = UDim2.new(0.5, -110, 0, 88)
button.Text = "🎶 เปิดเพลงใน Tool"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
button.TextSize = 14
button.Font = Enum.Font.GothamBold
button.Parent = frame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 6)
btnCorner.Parent = button

-- ปุ่ม Toggle (ปุ่มกลมเปิด-ปิดแบบไม่มีตัวอักษร)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 45, 0, 45)
toggleBtn.Position = UDim2.new(0, 50, 0, 50)
toggleBtn.Text = ""
toggleBtn.Active = true
toggleBtn.Draggable = true
toggleBtn.Parent = screenGui

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggleBtn

-- ระบบขอบวิบวับ ขาว-ดำ และปุ่มวิบวับแบบ "ช้าๆ" (ปรับเวลาจาก 0.2 เป็น 1.0 วินาที)
task.spawn(function()
    while screenGui and screenGui.Parent do
        -- ค่อยๆ เปลี่ยนเป็นสีขาว
        for i = 0, 1, 0.05 do
            if not screenGui or not screenGui.Parent then break end
            stroke.Color = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(0, 0, 0), i)
            toggleBtn.BackgroundColor3 = stroke.Color
            task.wait(0.05)
        end
        -- ค่อยๆ เปลี่ยนเป็นสีดำ
        for i = 0, 1, 0.05 do
            if not screenGui or not screenGui.Parent then break end
            stroke.Color = Color3.fromRGB(0, 0, 0):Lerp(Color3.fromRGB(255, 255, 255), i)
            toggleBtn.BackgroundColor3 = stroke.Color
            task.wait(0.05)
        end
    end
end)

local isOpen = true
toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    frame.Visible = isOpen
end)

toggleBtn.MouseButton2Click:Connect(function()
    screenGui:Destroy()
end)

-- ระบบส่งเพลง
button.MouseButton1Click:Connect(function()
    local songId = textBox.Text
    if songId ~= "" and songId ~= "ช่องใส่เพลง" then
        local args = {"ToolMusicText", songId, [4] = true}
        game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
        button.Text = "✅ ส่งเพลงสำเร็จ!"
        task.wait(1.5)
        button.Text = "🎶 เปิดเพลงใน Tool"
    end
end)

print("🖤🤍 Slow Flashing UI Loaded Successfully!")
