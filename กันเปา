-- ฟังก์ชันสุ่มเลขมั่ว
local function getRandomFakeId()
    local fakeIds = {"123456789", "987654321", "555555555", "888888888", "191919191"}
    return fakeIds[math.random(1, #fakeIds)]
end

-- ระบบส่งข้อมูล (ถ้าคนอื่นมารับค่าหรือดึงเพลง จะส่งเลขมั่วออกไปแทน)
local isCooldown = false

button.MouseButton1Click:Connect(function()
    if isCooldown then return end
    local realSongId = textBox.Text
    
    if realSongId ~= "" then
        isCooldown = true
        
        -- ส่งข้อมูลของเราตามปกติให้เกมเล่นเพลง
        local args = {
            "ToolMusicText",
            realSongId,
            [4] = true
        }
        game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
        
        antiSpamLabel.Text = "🔒 ป้องกันสำเร็จ (ส่งเลขมั่วให้คนอื่น)"
        
        -- สลับเอาเลขมั่วมาใส่ช่องหลอกคนดูด
        task.spawn(function()
            task.wait(1)
            textBox.Text = getRandomFakeId()
        end)

        task.wait(1.5)
        antiSpamLabel.Text = "🛡️ เปิดระบบส่งเลขมั่วเมื่อโดนดูด"
        isCooldown = false
    else
        textBox.PlaceholderText = "โปรดใส่ ID เพลงก่อน!"
    end
end)
